# Copy this file to ".env" to override values on your machine.
# Every value has a default in docker-compose.yml, so "docker compose up" works WITHOUT a .env file.

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host port to reach the DB from your PC (Visual Studio, DB tools). 5433 avoids clashing with a local Postgres.
DB_PORT=

# --- Backend ---
# How long a seat stays HELD before it expires (seconds).
HOLD_DURATION_SECONDS=
# Host port for the API. The brief requires 8080.
API_PORT=

# --- Frontend (used later) ---
FRONTEND_PORT=
API_BASE_URL=http://localhost:8080